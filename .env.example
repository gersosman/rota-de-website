# Required on Vercel. Local development uses PGlite in data/pglite when all of these are empty.
# Vercel Postgres exposes POSTGRES_URL. The server reads DATABASE_URL first, then POSTGRES_URL,
# then POSTGRES_PRISMA_URL. Do not commit a real URL. PGlite cannot store data on Vercel.
# DATABASE_URL=
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# DATABASE_URL_UNPOOLED=
# POSTGRES_URL_NON_POOLING=

# Required in production before the first admin can be created.
# Leave unset for local development.
# ADMIN_SETUP_TOKEN=

# Optional. Encrypts MFA secrets. If unset, a key is created inside the database.
# APP_ENCRYPTION_KEY=

# Public https origin. Unused while Telegram is disabled.
# APP_PUBLIC_URL=

# Telegram is disabled in the application. These values are not read by the live site.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_ADMIN_CHAT_ID=

# Public https origin. APP_PUBLIC_URL is preferred. APP_URL is the fallback for the webhook.
# APP_URL=

# OpenAI. The key stays on the server. Empty means the assistant says it is not connected.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Mail. RESEND_API_KEY and MAIL_FROM send the application code.
# CONTACT_NOTIFY_EMAIL receives contact-form notices. Do not put a personal address in source code.
# RESEND_API_KEY=
# MAIL_FROM=
# CONTACT_NOTIFY_EMAIL=

# Later phases read these on the server. They are not connected yet.
# Do not put them in frontend code. Leaving them empty keeps the integrations disconnected.
# META_APP_SECRET=
# META_PAGE_ACCESS_TOKEN=
# EMAIL_API_KEY=
# PAYMENT_SECRET_KEY=
# PAYMENT_WEBHOOK_SECRET=

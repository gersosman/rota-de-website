# Optional. When unset, the app uses a local PGlite database in data/pglite.
# Cursor hosting injects DATABASE_URL for the app database. Do not commit a real URL.
# A Supabase Postgres connection string can be used here by the server only.
# DATABASE_URL=

# Required in production before the first admin can be created.
# Leave unset for local development.
# ADMIN_SETUP_TOKEN=

# Optional. Encrypts MFA secrets. If unset, a key is created inside the database.
# APP_ENCRYPTION_KEY=

# Public https origin used only to register the Telegram webhook.
# Leave empty in local development. A missing or non-https value keeps the bot disconnected.
# APP_PUBLIC_URL=

# Telegram Bot API. Both values are required before the admin check can mark the bot connected.
# The bot username is the public contact. Do not put a personal phone number here.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# Optional chat that receives a short human-handoff notice. Never a phone number and never shown on the site.
# TELEGRAM_ADMIN_CHAT_ID=

# WhatsApp Business Cloud API. All values stay on the server.
# The public button appears only after the business number is verified.
# Do not put a personal phone number in any of these.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_ADMIN_PHONE=
# WHATSAPP_API_VERSION=v21.0
# APP_URL=

# Later phases read these on the server. They are not connected yet.
# Do not put them in frontend code. Leaving them empty keeps the integrations disconnected.
# META_APP_SECRET=
# META_PAGE_ACCESS_TOKEN=
# EMAIL_API_KEY=
# PAYMENT_SECRET_KEY=
# PAYMENT_WEBHOOK_SECRET=
